# NEXT_PUBLIC_* values are baked in at build time - redeploy after changing.
# On Vercel, set these per environment (Production -> main backend, Preview -> dev backend).

# staff-portal-be (Azure AmniPortal02 / AmniPortal02dev). Never leave blank in production.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_DEV_BACKEND_URL=http://localhost:8086

# Firebase project (amniportal). Defaults in src/lib/firebase.ts match the legacy portal.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=amniportal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=amniportal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=amniportal.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Azure AD tenant for Microsoft sign-in
NEXT_PUBLIC_MS_TENANT_ID=ce77023f-6530-4864-94d0-026b6671b462

# Where the legacy Angular portal stays reachable during the migration.
# Must NOT be portal.amni.com once this app serves that domain.
NEXT_PUBLIC_LEGACY_PORTAL_URL=
